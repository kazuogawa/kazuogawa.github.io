---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header';
import AudienceCards from '../components/AudienceCards.astro';
import Contact from '../components/Contact.astro';
import SocialIcons from '../components/SocialIcons.astro';
import { profile } from '../data/profile';

const { landing, name, photo, social } = profile;
---

<BaseLayout title="小川 和久 | AI開発支援・Web開発・IT活用相談" seo={landing.seo}>
  <Header client:visible />
  <main>
    <section class="px-6 py-16 md:py-24">
      <div class="mx-auto grid max-w-5xl gap-10 md:grid-cols-[auto_1fr] md:items-center">
        <img
          src={photo}
          srcset="/images/myphoto-384.webp 384w, /images/myphoto.webp 448w"
          sizes="(min-width: 768px) 176px, 144px"
          alt={`${name.ja}のプロフィール写真`}
          class="mx-auto h-36 w-36 rounded-full object-cover shadow-lg ring-4 ring-white md:h-44 md:w-44 dark:ring-slate-800"
          width="448"
          height="448"
          loading="eager"
          fetchpriority="high"
        />
        <div class="text-center md:text-left">
          <p
            class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-600 dark:text-blue-400"
          >
            {landing.eyebrow}
          </p>
          <h1
            class="mt-3 text-4xl font-bold tracking-tight text-slate-900 md:text-5xl dark:text-white"
          >
            {name.ja}
          </h1>
          <p class="mt-1 text-slate-500 dark:text-slate-400">{name.en}</p>
          <h2 class="mt-6 text-2xl font-bold text-slate-900 md:text-3xl dark:text-white">
            {landing.title}
          </h2>
          <p class="mt-4 max-w-3xl leading-8 text-slate-600 dark:text-slate-300">
            {landing.description}
          </p>
          <div class="mt-6 flex justify-center md:justify-start">
            <SocialIcons links={social} />
          </div>
        </div>
      </div>
    </section>

    <section class="bg-slate-50 px-6 py-20 dark:bg-slate-800/50">
      <div class="mx-auto max-w-5xl">
        <h2 class="text-3xl font-bold text-slate-900 dark:text-white">
          ご相談・確認したい内容からお選びください
        </h2>
        <div class="mt-10">
          <AudienceCards audiences={landing.audiences} />
        </div>
      </div>
    </section>

    <section class="px-6 py-20">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-3xl font-bold text-slate-900 dark:text-white">{landing.historyTitle}</h2>
        {
          landing.history.map((paragraph) => (
            <p class="mt-5 leading-8 text-slate-600 dark:text-slate-300">{paragraph}</p>
          ))
        }
      </div>
    </section>

    <Contact />
  </main>
</BaseLayout>
