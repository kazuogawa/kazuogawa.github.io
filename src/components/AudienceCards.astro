---
import type { AudienceLink } from '../types/profile';

interface Props {
  audiences: AudienceLink[];
}

const { audiences } = Astro.props;
---

<div class="grid gap-5 md:grid-cols-2">
  {
    audiences.map((audience) => (
      <a
        href={audience.href}
        class="group rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-blue-400 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:border-slate-700 dark:bg-slate-900 dark:hover:border-blue-500 dark:focus:ring-offset-slate-900"
      >
        <h3 class="text-xl font-semibold text-slate-900 group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400">
          {audience.title}
          <span aria-hidden="true" class="ml-2">
            →
          </span>
        </h3>
        <p class="mt-3 leading-7 text-slate-600 dark:text-slate-300">{audience.description}</p>
      </a>
    ))
  }
</div>
