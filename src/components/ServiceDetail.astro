---
import type { ServicePageContent } from '../types/profile';
import Header from './Header';
import { profile } from '../data/profile';

interface Props {
  page: ServicePageContent;
}

const { page } = Astro.props;
const { contact } = profile;
---

<Header client:visible />
<main>
  <section id="services" class="scroll-mt-20 px-6 py-16 md:py-24">
    <div class="mx-auto max-w-5xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-600 dark:text-blue-400">
        {page.eyebrow}
      </p>
      <h1 class="mt-4 max-w-4xl text-4xl font-bold text-slate-900 md:text-5xl dark:text-white">
        {page.title}
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600 dark:text-slate-300">
        {page.description}
      </p>
      <p class="mt-5 max-w-3xl font-medium text-slate-800 dark:text-slate-100">
        {page.availability}
      </p>
      <a
        href={contact.primaryAction.url}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex min-h-11 items-center justify-center rounded-md bg-blue-600 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900"
      >
        {page.ctaLabel}
      </a>
    </div>
  </section>

  <section class="bg-slate-50 px-6 py-20 dark:bg-slate-800/50">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white">
        このようなご相談に対応します
      </h2>
      <ul class="mt-10 grid gap-4 md:grid-cols-2">
        {
          page.challenges.map((challenge) => (
            <li class="rounded-lg border border-slate-200 bg-white p-5 leading-7 text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">
              {challenge}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="process" class="scroll-mt-20 px-6 py-20">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white">{page.processTitle}</h2>
      <ol class="mt-10 grid gap-6 md:grid-cols-2">
        {
          page.process.map((step, index) => (
            <li class="border-t border-slate-300 pt-5 dark:border-slate-600">
              <p class="text-sm font-semibold text-blue-600 dark:text-blue-400">STEP {index + 1}</p>
              <h3 class="mt-2 text-lg font-semibold text-slate-900 dark:text-white">
                {step.title}
              </h3>
              <p class="mt-3 leading-7 text-slate-600 dark:text-slate-300">{step.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="bg-slate-50 px-6 py-20 dark:bg-slate-800/50">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white">{page.casesTitle}</h2>
      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {
          page.cases.map((item) => (
            <article class="rounded-xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900">
              <h3 class="text-xl font-semibold text-slate-900 dark:text-white">{item.title}</h3>
              {item.paragraphs.map((paragraph) => (
                <p class="mt-3 leading-7 text-slate-600 dark:text-slate-300">{paragraph}</p>
              ))}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="contact" class="scroll-mt-20 px-6 py-20">
    <div
      class="mx-auto max-w-5xl rounded-3xl border border-slate-200 bg-white p-8 shadow-sm md:p-10 dark:border-slate-700 dark:bg-slate-900"
    >
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white">{page.ctaTitle}</h2>
      <p class="mt-4 max-w-3xl leading-7 text-slate-600 dark:text-slate-300">
        {page.ctaDescription}
      </p>
      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <a
          href={contact.primaryAction.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center justify-center rounded-md bg-blue-600 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900"
        >
          {page.ctaLabel}
        </a>
        <a
          href="/portfolio/"
          class="inline-flex min-h-11 items-center justify-center rounded-md border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 transition-colors hover:border-blue-500 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:border-slate-600 dark:text-slate-200 dark:hover:border-blue-400 dark:hover:text-blue-400 dark:focus:ring-offset-slate-900"
        >
          経歴・技術実績を見る
        </a>
      </div>
    </div>
  </section>
</main>
