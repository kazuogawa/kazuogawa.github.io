{
  "name": "kazuogawa-portfolio",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "volta": {
    "node": "24.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint . --ext .ts,.tsx,.astro",
    "format": "prettier --write \"src/**/*.{ts,tsx,astro,css}\" \"playwright.config.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,astro,css}\" \"playwright.config.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "make check",
    "test:e2e": "playwright test",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^7.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^3.4.17",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.1",
    "@typescript-eslint/parser": "^8.19.0",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "eslint-plugin-react": "^7.37.3",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3"
  }
}
