{
  "name": "kazuogawa-portfolio",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@12.3.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "volta": {
    "node": "24.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check:links": "linkinator https://kazuogawa.github.io/ --recurse --check-fragments --retry --retry-errors --retry-errors-count 3 --timeout 30000",
    "preview": "astro preview",
    "lint": "eslint . --ext .ts,.tsx,.astro",
    "format": "prettier --write \"src/**/*.{ts,tsx,astro,css}\" \"playwright.config.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,astro,css}\" \"playwright.config.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "make check",
    "test:e2e": "playwright test",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@astrojs/tailwind": "^6.0.2",
    "@openai/codex-security": "^0.1.25",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.2.5",
    "astro": "^7.2.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.1",
    "lighthouse": "^13.4.1",
    "linkinator": "^8.1.0",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3"
  }
}
